# secrets and claimant data — never commit
instance/
uploads/
dossiers/
dossiers/*/
*.db
*.sqlite
*.sqlite3
*.json.key
*service-account*.json
.env
.env.*

# local backups and copyrighted reference papers — keep local, never publish
backup_pre_upgrade_*/
docs/references/

# generated runtime logs, legacy demo images, and large regenerable validation samples
*.log
artifacts/*_JL-*.png
artifacts/validation/*_samples.json
artifacts/validation/rf_samples_latest.json

# Python / virtual environments / testing
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/

# IDE and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
